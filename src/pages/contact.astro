---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import { site } from '../data/site';
import '../styles/contact.css';

const { googleVoiceNumber, web3FormsAccessKey, mailingListUrl } = site.contact;
const phoneHref = googleVoiceNumber ? `tel:${googleVoiceNumber.replace(/[^+\d]/g, '')}` : undefined;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Emily at Reveal & Remember. Call, send a message, or join the mailing list."
>
  <div class="contact-page page-shell">
    <main id="main-content">
      <div class="page-header">
        <h1>Get in Touch</h1>
        <p>Let's find out if we're a fit.</p>
      </div>

      <section class="contact-section contact-intro">
        <div class="container contact-intro__grid">
          <img
            src="/images/emily-photo-full-size.jpg"
            alt="Emily smiling outdoors in golden afternoon light"
            class="contact-intro__photo"
          />
          <div class="contact-intro__copy">
            <p class="section-eyebrow">A Note on Consults</p>
            <p>A consult is not a sales call. It is a mutual discernment space.</p>
            <p>
              You get to feel whether my presence, my way of working, and the field of this work
              feel right for your system. I get to feel whether I am the right person to support you.
            </p>
            <p>
              There is no pressure to convince yourself into a yes. In fact, that is part of the work.
            </p>
            <p>We are listening for what is true.</p>
          </div>
        </div>
      </section>

      <section class="contact-section contact-options" aria-labelledby="contact-options-title">
        <div class="contact-options__inner">
          <h2 id="contact-options-title" class="sr-only">Ways to get in touch</h2>

          <div class="contact-accordion">
            <article class="contact-card">
              <button class="contact-card__trigger" type="button" aria-expanded="false" aria-controls="call-panel">
                <span class="contact-card__heading">
                  <span class="contact-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92z" /></svg>
                  </span>
                  <span><span class="contact-card__title">Call Me</span><span class="contact-card__subtitle">Reach me by phone</span></span>
                </span>
                <span class="contact-card__toggle" aria-hidden="true">+</span>
              </button>
              <div class="contact-card__panel" id="call-panel" hidden>
                <div class="contact-card__body">
                  <p>I’d love to hear your voice.

Of note: this line is not appropriate for sensitive clinical information and is not monitored for emergencies.</p>
                  {phoneHref ? (
                    <a class="cta-button" href={phoneHref}>{googleVoiceNumber}</a>
                  ) : (
                    <p class="contact-placeholder">Google Voice number will be added here.</p>
                  )}
                </div>
              </div>
            </article>

            <article class="contact-card">
              <button class="contact-card__trigger" type="button" aria-expanded="false" aria-controls="email-panel">
                <span class="contact-card__heading">
                  <span class="contact-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="1" /><path d="m2 5 10 8 10-8" /></svg>
                  </span>
                  <span><span class="contact-card__title">Email Me</span><span class="contact-card__subtitle">Send a private message</span></span>
                </span>
                <span class="contact-card__toggle" aria-hidden="true">+</span>
              </button>
              <div class="contact-card__panel" id="email-panel" hidden>
                <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
                  <input type="hidden" name="access_key" value={web3FormsAccessKey} />
                  <input type="hidden" name="subject" value="New Reveal & Remember contact form message" />
                  <input type="hidden" name="from_name" value="Reveal & Remember Website" />
                  <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
                  <div class="form-group">
                    <label for="contact-name">Your name</label>
                    <input id="contact-name" name="name" type="text" placeholder="First name" autocomplete="name" required />
                  </div>
                  <div class="form-group">
                    <label for="contact-email">Email address</label>
                    <input id="contact-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
                  </div>
                  <div class="form-group">
                    <label for="contact-message">Your message</label>
                    <textarea id="contact-message" name="message" placeholder="What's on your mind?" required></textarea>
                    <p class="form-note">All messages are held with complete confidentiality.</p>
                  </div>
                  <button class="cta-button" type="submit" disabled={!web3FormsAccessKey}>Send Message</button>
                  <p class="form-status" role="status" aria-live="polite"></p>
                  {!web3FormsAccessKey && <p class="contact-placeholder">The form will be enabled when the Web3Forms access key is added.</p>}
                </form>
                <div class="form-success" hidden>
                  <span class="form-success__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
                  </span>
                  <h3 class="form-success__title" tabindex="-1">Message Sent</h3>
                  <p>Thank you for reaching out. I’ll respond within a few business days.</p>
                  <button class="form-success__reset" type="button">Send another message</button>
                </div>
              </div>
            </article>

            <article class="contact-card">
              <button class="contact-card__trigger" type="button" aria-expanded="false" aria-controls="mailing-list-panel">
                <span class="contact-card__heading">
                  <span class="contact-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                  </span>
                  <span><span class="contact-card__title">Join the Mailing List</span><span class="contact-card__subtitle">Stay in the loop</span></span>
                </span>
                <span class="contact-card__toggle" aria-hidden="true">+</span>
              </button>
              <div class="contact-card__panel" id="mailing-list-panel" hidden>
                <div class="contact-card__body">
                  <p>
                    Not sure where you fit yet—or just want to stay connected? Join the list for updates
                    on group offerings, workshops, live events, and new resources.
                  </p>
                  {mailingListUrl ? (
                    <a class="cta-button" href={mailingListUrl} target="_blank" rel="noopener noreferrer">Join the List</a>
                  ) : (
                    <p class="contact-placeholder">The Google Form link will be added here.</p>
                  )}
                </div>
              </div>
            </article>
          </div>

          <div class="audio-nudge">
            <p>
              Not sure if this work is for you? Start with the <a href="/resources">audio resources</a>.
              If something connects, we may be a good fit. If it doesn't land—I wish you well on your
              healing journey, wherever it leads.
            </p>
          </div>
        </div>
      </section>
    </main>
  </div>

  <QuoteBanner quote={`"The privilege of a lifetime is to become who you truly are."`} author="— C.G. Jung" />
</BaseLayout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>('.contact-card__trigger');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const shouldOpen = trigger.getAttribute('aria-expanded') !== 'true';

      triggers.forEach((otherTrigger) => {
        const panelId = otherTrigger.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        otherTrigger.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      });

      const panelId = trigger.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      trigger.setAttribute('aria-expanded', String(shouldOpen));
      if (panel) panel.hidden = !shouldOpen;
    });
  });

  const contactForm = document.querySelector<HTMLFormElement>('.contact-form');
  const successPanel = document.querySelector<HTMLElement>('.form-success');
  const sendAnotherButton = document.querySelector<HTMLButtonElement>('.form-success__reset');

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = contactForm.querySelector<HTMLElement>('.form-status');
    if (!submitButton || !status) return;

    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'form-status';

    try {
      const response = await fetch(contactForm.action, {
        method: 'POST',
        body: new FormData(contactForm),
        headers: { Accept: 'application/json' }
      });
      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || 'Unable to send your message.');
      }

      contactForm.reset();
      contactForm.hidden = true;
      if (successPanel) {
        successPanel.hidden = false;
        const successTitle = successPanel.querySelector<HTMLElement>('.form-success__title');
        successTitle?.focus();
        successPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } catch (error) {
      status.textContent = error instanceof Error
        ? error.message
        : 'Unable to send your message. Please try again.';
      status.classList.add('form-status--error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send Message';
    }
  });

  sendAnotherButton?.addEventListener('click', () => {
    if (!contactForm || !successPanel) return;

    successPanel.hidden = true;
    contactForm.hidden = false;
    contactForm.querySelector<HTMLInputElement>('#contact-name')?.focus();
  });
</script>
