---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import { site } from '../data/site';
import '../styles/contact.css';

const { googleVoiceNumber, web3FormsAccessKey, mailingListUrl } = site.contact;
const phoneHref = googleVoiceNumber ? `tel:${googleVoiceNumber.replace(/[^+\d]/g, '')}` : undefined;

// Structured data so Google and AI tools can read the contact facts directly.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.siteUrl}/#emily`,
      name: 'Emily Fox',
      honorificSuffix: 'PsyD',
      jobTitle: 'Guided Healing Practitioner',
      url: `${site.siteUrl}/about-me`,
      worksFor: { '@id': `${site.siteUrl}/#practice` }
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.siteUrl}/#practice`,
      name: 'Reveal & Remember',
      url: site.siteUrl,
      ...(googleVoiceNumber && { telephone: `+1-${googleVoiceNumber}` }),
      description: 'Virtual guided healing for women, offered over Zoom to women anywhere.',
      areaServed: 'Worldwide',
      founder: { '@id': `${site.siteUrl}/#emily` }
    }
  ]
};
---

<BaseLayout
  title="Contact"
  description="Contact Emily Fox, PsyD at Reveal & Remember. Book a free 20-minute phone consult, call, or send a private message. Virtual guided healing over Zoom for women anywhere."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="contact-page">
    <main id="main-content">
      <PageHeader title="Get in Touch" subtitle="Let's find out if we're a fit." />

      <section class="section surface-base contact-ways" aria-labelledby="contact-ways-title">
        <div class="section-inner">
          <div class="contact-intro text-center">
            <p class="contact-intro__lead">
              The easiest way to begin is to schedule a free 20-minute consult with me, Emily Fox, PsyD.
              We'll talk about what's happening for you and whether guided healing feels right.
            </p>
            <a class="cta-button" href={site.calendlyUrl} target="_blank" rel="noreferrer">Schedule a Consult</a>
          </div>

          <h2 id="contact-ways-title" class="sr-only">Ways to get in touch</h2>
          <div class="contact-tiles">
            <a class="contact-tile" href={site.calendlyUrl} target="_blank" rel="noreferrer">
              <span class="contact-tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="1" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
              </span>
              <span class="contact-tile__title">Book a Consult</span>
              <span class="contact-tile__detail">Schedule your 20min free initial consultation</span>
            </a>
            {phoneHref && (
              <a class="contact-tile" href={phoneHref}>
                <span class="contact-tile__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92z" /></svg>
                </span>
                <span class="contact-tile__title">Call Me</span>
                <span class="contact-tile__detail">Call me directly at {googleVoiceNumber}</span>
              </a>
            )}
            <button class="contact-tile" type="button" aria-expanded="false" aria-controls="message-panel">
              <span class="contact-tile__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="1" /><path d="m2 5 10 8 10-8" /></svg>
              </span>
              <span class="contact-tile__title">Email Me</span>
              <span class="contact-tile__detail">Send me a brief message with any questions and I will respond as quickly as I am able.</span>
            </button>
          </div>

          <p class="contact-caution">
            <span class="contact-caution__label">Please note</span>
            Do not include any clinically sensitive or emergency-related information when you call, leave a voicemail,
            or send a message. I do not provide emergency care services and will be unable to appropriately
            attend to these messages.
          </p>

          <div class="card contact-message" id="message-panel" hidden>
            <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
                  <input type="hidden" name="access_key" value={web3FormsAccessKey} />
                  <input type="hidden" name="subject" value="New Reveal & Remember contact form message" />
                  <input type="hidden" name="from_name" value="Reveal & Remember Website" />
                  <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
                  <div class="form-group">
                    <label for="contact-name">Your name</label>
                    <input id="contact-name" name="name" type="text" placeholder="First name" autocomplete="name" required />
                  </div>
                  <div class="form-group">
                    <label for="contact-email">Email address</label>
                    <input id="contact-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
                  </div>
                  <div class="form-group">
                    <label for="contact-message">Your message</label>
                    <textarea id="contact-message" name="message" placeholder="What's on your mind?" required></textarea>
                    <p class="form-note">All messages are held with complete confidentiality.</p>
                  </div>
                  <button class="cta-button" type="submit" disabled={!web3FormsAccessKey}>Send Message</button>
                  <p class="form-status" role="status" aria-live="polite"></p>
                  {!web3FormsAccessKey && <p class="contact-placeholder">The form will be enabled when the Web3Forms access key is added.</p>}
                </form>
            <div class="form-success" hidden>
                  <span class="form-success__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
                  </span>
                  <h3 class="form-success__title" tabindex="-1">Message Sent</h3>
                  <p>Thank you for reaching out. I’ll respond within 1-5 business days.</p>
                  <button class="form-success__reset" type="button">Send another message</button>
                </div>
          </div>

          <p class="contact-ways__extras">
            Not sure yet? Start with the <a href="/resources">audio resources</a>{mailingListUrl && (
              <> or <a href={mailingListUrl} target="_blank" rel="noopener noreferrer">join the mailing list</a></>
            )}.
          </p>
        </div>
      </section>

      <section class="section surface-alt contact-note">
        <div class="section-inner section-inner--narrow text-center">
          <h2 class="text-eyebrow">A Note on Consults</h2>
          <p>
            A consult is not a sales call. It is a mutual discernment space. You get to feel whether
            my presence and my way of working feel right for your system, and I get to feel whether
            I am the right person to support you.
          </p>
          <p>There is no pressure to convince yourself into a yes. In fact, that is part of the work.</p>
          <p class="contact-note__closing">We are listening for what is true.</p>
        </div>
      </section>

      <section class="contact-facts">
        <div class="section-inner text-center">
          <p>Please note: Initial free consults are conducted by phone, while ongoing sessions are provided virtually over Zoom. Guided healing is open to women anywhere. For any inquiries, please expect a reply within 1-5 business days.</p>
          <p>
            If you are in crisis, please don't wait for a reply. Call or text <a href="tel:988">988</a>
            (Suicide &amp; Crisis Lifeline), or call <a href="tel:911">911</a>.
            Guided healing is a non-clinical service and not psychotherapy.
          </p>
        </div>
      </section>
    </main>
  </div>

  <QuoteBanner quote={`"The privilege of a lifetime is to become who you truly are."`} author="— C.G. Jung" />
</BaseLayout>

<script>
  const messageTile = document.querySelector<HTMLButtonElement>('button.contact-tile');
  const messagePanel = document.getElementById('message-panel');

  messageTile?.addEventListener('click', () => {
    if (!messagePanel) return;
    const open = messageTile.getAttribute('aria-expanded') !== 'true';
    messageTile.setAttribute('aria-expanded', String(open));
    messagePanel.hidden = !open;
    if (open) {
      messagePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      messagePanel.querySelector<HTMLInputElement>('#contact-name')?.focus({ preventScroll: true });
    }
  });

  const contactForm = document.querySelector<HTMLFormElement>('.contact-form');
  const successPanel = document.querySelector<HTMLElement>('.form-success');
  const sendAnotherButton = document.querySelector<HTMLButtonElement>('.form-success__reset');

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = contactForm.querySelector<HTMLElement>('.form-status');
    if (!submitButton || !status) return;

    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    status.textContent = '';
    status.className = 'form-status';

    try {
      const response = await fetch(contactForm.action, {
        method: 'POST',
        body: new FormData(contactForm),
        headers: { Accept: 'application/json' }
      });
      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || 'Unable to send your message.');
      }

      contactForm.reset();
      contactForm.hidden = true;
      if (successPanel) {
        successPanel.hidden = false;
        const successTitle = successPanel.querySelector<HTMLElement>('.form-success__title');
        successTitle?.focus();
        successPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } catch (error) {
      status.textContent = error instanceof Error
        ? error.message
        : 'Unable to send your message. Please try again.';
      status.classList.add('form-status--error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send Message';
    }
  });

  sendAnotherButton?.addEventListener('click', () => {
    if (!contactForm || !successPanel) return;

    successPanel.hidden = true;
    contactForm.hidden = false;
    contactForm.querySelector<HTMLInputElement>('#contact-name')?.focus();
  });
</script>
